// ==============================================================================
// 02. INSERTION & REMOVAL OPERATIONS
// ==============================================================================
// Objective: Test insertion, ordered removal, and unordered removal.
// English: Test insertion, ordered removal, and unordered removal.
// ==============================================================================

import("../vec");

fun main() {
    println("=== 02. INSERTION & REMOVAL OPERATIONS ===");
    
    var v: ptr<Vec<i32>> = vec_new_heap<i32>(4);
    
    var n1: i32 = 10; var n2: i32 = 20; var n3: i32 = 30;
    vec_push<i32>(v, &n1); // [10]
    vec_push<i32>(v, &n2); // [10, 20]
    vec_push<i32>(v, &n3); // [10, 20, 30]
    
    // Print initial state
    println("Initial vector:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 20; }
            else if (i == 2) { expected_val = 30; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    // 1. vec_insert: Insert value 99 at index 1 (shift elements right, O(N))
    var insert_val: i32 = 99;
    vec_insert<i32>(v, 1, &insert_val); 
    // v = [10, 99, 20, 30]
    println("\nAfter inserting 99 at index 1:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 99; }
            else if (i == 2) { expected_val = 20; }
            else if (i == 3) { expected_val = 30; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    // 2. vec_pop: Get and remove last element
    var popped: i32 = 0;
    var success: bool = vec_pop<i32>(v, &popped); 
    // popped = 30, v = [10, 99, 20]
    println("\nAfter popping last element:");
    println("Popped value: {} (Expected: 30)", popped);
    println("Success: {} (Expected: true)", success);
    println("Remaining vector:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 99; }
            else if (i == 2) { expected_val = 20; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    // 3. vec_remove: Remove index 1 (value 99), keep order of subsequent elements (O(N))
    vec_remove<i32>(v, 1);
    // v = [10, 20]
    println("\nAfter removing element at index 1 (value 99):");
    println("Vector after removal:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 20; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    // Add elements back to test remove_swap
    var n4: i32 = 30; var n5: i32 = 40; var n6: i32 = 50;
    vec_push<i32>(v, &n4); // [10, 20, 30]
    vec_push<i32>(v, &n5); // [10, 20, 30, 40]
    vec_push<i32>(v, &n6); // [10, 20, 30, 40, 50]
    
    println("\nAfter adding 30, 40, 50:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 20; }
            else if (i == 2) { expected_val = 30; }
            else if (i == 3) { expected_val = 40; }
            else if (i == 4) { expected_val = 50; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    // 4. vec_remove_swap: Remove index 1 (value 20) by swapping with last element
    // This is an O(1) operation, extremely fast, but order will change.
    // Last element (50) will be moved to index 1.
    vec_remove_swap<i32>(v, 1);
    // v = [10, 50, 30, 40]
    println("\nAfter vec_remove_swap at index 1 (swaps with last element):");
    println("Vector after swap removal:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 50; }  // 50 was moved from the end
            else if (i == 2) { expected_val = 30; }
            else if (i == 3) { expected_val = 40; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    
    println("\nFinal length: {} (Expected: 4)", vec_len<i32>(v));
    println("Final capacity: {} (Expected: >=4)", vec_capacity<i32>(v));
    
    vec_destroy<i32>(&v);
    
    println("=== END 02. INSERTION & REMOVAL OPERATIONS ===\n");
}
