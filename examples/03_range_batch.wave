// ==============================================================================
// 03. RANGE & BATCH OPERATIONS
// ==============================================================================
// Objective: Test range operations, batching, and memory optimization.
// English: Test range operations, batching, and memory optimization.
// ==============================================================================

import("../vec");

fun main() {
    println("=== 03. RANGE & BATCH OPERATIONS ===");
    
    var v: ptr<Vec<i32>> = vec_new_heap<i32>(4);
    
    // Setup initial data: [10, 20, 30, 40, 50]
    var v1: i32 = 10; var v2: i32 = 20; var v3: i32 = 30; 
    var v4: i32 = 40; var v5: i32 = 50;
    vec_push<i32>(v, &v1); vec_push<i32>(v, &v2); vec_push<i32>(v, &v3);
    vec_push<i32>(v, &v4); vec_push<i32>(v, &v5);
    
    println("Initial vector:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 20; }
            else if (i == 2) { expected_val = 30; }
            else if (i == 3) { expected_val = 40; }
            else if (i == 4) { expected_val = 50; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v), vec_capacity<i32>(v));
    
    // 1. vec_extend: Add a block of elements from another memory region
    var temp_v: Vec<i32> = vec_new<i32>(4);
    var e1: i32 = 100; var e2: i32 = 200; var e3: i32 = 300;
    vec_push<i32>(&temp_v, &e1); vec_push<i32>(&temp_v, &e2); vec_push<i32>(&temp_v, &e3);
    vec_extend<i32>(v, temp_v.data, temp_v.len); // v = [10, 20, 30, 40, 50, 100, 200, 300]
    vec_free<i32>(&temp_v);
    
    println("\nAfter vec_extend with [100, 200, 300]:");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 20; }
            else if (i == 2) { expected_val = 30; }
            else if (i == 3) { expected_val = 40; }
            else if (i == 4) { expected_val = 50; }
            else if (i == 5) { expected_val = 100; }
            else if (i == 6) { expected_val = 200; }
            else if (i == 7) { expected_val = 300; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v), vec_capacity<i32>(v));
    
    // 2. vec_remove_range: Remove range [1, 3) -> remove index 1, 2 (values 20, 30), keep order
    vec_remove_range<i32>(v, 1, 3);
    // v = [10, 40, 50, 100, 200, 300]
    println("\nAfter vec_remove_range [1, 3) (removing values 20, 30):");
    for (var i: i64 = 0; i < vec_len<i32>(v); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 10; }
            else if (i == 1) { expected_val = 40; }
            else if (i == 2) { expected_val = 50; }
            else if (i == 3) { expected_val = 100; }
            else if (i == 4) { expected_val = 200; }
            else if (i == 5) { expected_val = 300; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v), vec_capacity<i32>(v));
    
    // 3. vec_dedup: Remove adjacent duplicate elements (need sorted array first)
    var v2: ptr<Vec<i32>> = vec_new_heap<i32>(4);
    var a: i32 = 5; var b: i32 = 5; var c: i32 = 10; var d: i32 = 10; var e: i32 = 15;
    vec_push<i32>(v2, &a); vec_push<i32>(v2, &b); vec_push<i32>(v2, &c);
    vec_push<i32>(v2, &d); vec_push<i32>(v2, &e); // [5, 5, 10, 10, 15]
    
    println("\nVector v2 before dedup [5, 5, 10, 10, 15]:");
    for (var i: i64 = 0; i < vec_len<i32>(v2); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v2, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 5; }
            else if (i == 1) { expected_val = 5; }
            else if (i == 2) { expected_val = 10; }
            else if (i == 3) { expected_val = 10; }
            else if (i == 4) { expected_val = 15; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    var dedup_result: i64 = vec_dedup<i32>(v2); // v2 = [5, 10, 15]
    println("\nAfter vec_dedup (removed {} duplicates):", dedup_result);
    for (var i: i64 = 0; i < vec_len<i32>(v2); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v2, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 5; }
            else if (i == 1) { expected_val = 10; }
            else if (i == 2) { expected_val = 15; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    // 4. vec_swap_at: Swap positions 0 and 2 in O(1)
    vec_swap_at<i32>(v2, 0, 2); // v2 = [15, 10, 5]
    println("\nAfter vec_swap_at(0, 2) (swap values 5 and 15):");
    for (var i: i64 = 0; i < vec_len<i32>(v2); i = i + 1) {
        var elem: ptr<i32> = vec_get<i32>(v2, i);
        if (elem != null) {
            var expected_val: i32 = 0;
            if (i == 0) { expected_val = 15; }
            else if (i == 1) { expected_val = 10; }
            else if (i == 2) { expected_val = 5; }
            println("  Index {}: {} (Expected: {})", i, deref elem, expected_val);
        }
    }
    println("Length: {}, Capacity: {}", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    // 5. vec_reserve & vec_shrink_to_fit: Active memory management
    var old_cap: i64 = vec_capacity<i32>(v2);
    vec_reserve<i32>(v2, 100);      // Force capacity to 100
    println("\nAfter vec_reserve(100) (capacity increased from {} to {}):", old_cap, vec_capacity<i32>(v2));
    println("Length: {}, Capacity: {}", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    vec_shrink_to_fit<i32>(v2);     // Reduce capacity to match len (3) to save RAM
    println("\nAfter vec_shrink_to_fit (capacity reduced to match length):");
    println("Length: {}, Capacity: {} (Expected: Length=3, Capacity=3)", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    // 6. vec_clear: Clear all but keep capacity
    vec_clear<i32>(v2); // Len = 0, Cap = 3
    println("\nAfter vec_clear (length reset to 0, capacity preserved):");
    println("Length: {}, Capacity: {} (Expected: Length=0, Capacity=3)", vec_len<i32>(v2), vec_capacity<i32>(v2));
    
    vec_destroy<i32>(&v);
    vec_destroy<i32>(&v2);
    
    println("=== END 03. RANGE & BATCH OPERATIONS ===\n");
}
